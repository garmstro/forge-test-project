DATABASE_URL=sqlite+aiosqlite:///./linkvault.db
# SEC-16: Replace this with a strong random key before running the app.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# The app will refuse to start if this value starts with "changeme" or is
# shorter than 32 characters.
SECRET_KEY=replace-me-with-output-of-secrets-token-hex-32
BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
SCHEDULER_DB_URL=sqlite:///./scheduler.db
# SEC-12: Comma-separated list of allowed CORS origins.
# Leave empty to disallow all cross-origin requests (recommended for production).
# Example for local development: CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=

