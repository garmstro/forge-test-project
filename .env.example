DATABASE_URL=sqlite+aiosqlite:///./linkvault.db
SECRET_KEY=changeme-use-a-real-secret
BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
SCHEDULER_DB_URL=sqlite:///./scheduler.db

# Rate Limiting
# Requests per window for authenticated users (default: 100 per 60 seconds)
RATE_LIMIT_AUTHENTICATED_REQUESTS=100
RATE_LIMIT_AUTHENTICATED_WINDOW_SECONDS=60

# Requests per window for unauthenticated/IP-based limiting (default: 30 per 60 seconds)
RATE_LIMIT_IP_REQUESTS=30
RATE_LIMIT_IP_WINDOW_SECONDS=60

# Enable/disable rate limiting globally (default: true)
RATE_LIMITING_ENABLED=true
