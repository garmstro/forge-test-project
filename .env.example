DATABASE_URL=sqlite+aiosqlite:///./linkvault.db
SECRET_KEY=changeme-use-a-real-secret
BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
SCHEDULER_DB_URL=sqlite:///./scheduler.db

# Rate limiting — "<count>/<period>" where period is second|minute|hour|day
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_WRITE=60/minute
RATE_LIMIT_READ=300/minute
RATE_LIMIT_REDIRECT=600/minute
