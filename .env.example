DATABASE_URL=sqlite+aiosqlite:///./linkvault.db
SECRET_KEY=changeme-use-a-real-secret
BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
SCHEDULER_DB_URL=sqlite:///./scheduler.db

# Rate limiting configuration
# Set to false to disable all rate limiting
RATE_LIMIT_ENABLED=true
# Auth endpoints (register, token): requests per minute per IP
RATE_LIMIT_AUTH=10/minute
# Link management endpoints: requests per minute per user
RATE_LIMIT_LINKS=60/minute
# Analytics endpoints: requests per minute per user
RATE_LIMIT_ANALYTICS=30/minute
# Redirect endpoint: requests per minute per IP
RATE_LIMIT_REDIRECTS=120/minute

